insert

$d isa dungeon, has id 'superawesomedungeon2', has name 'Super Awesome Dungeon 2';

# Rooms

$r isa room, has name "Entry hall", has id "superawesomedungeon-entryhall";
dungeon-composition ($d, $r);

# Monsters

$m isa monster,
  has name "Tarrasque",
  has id "entryhall-tarrasque",
  has description "
The legendary tarrasque is possibly the most dreaded monster of the Material Plane. It is widely believed that only one of these creatures exists, though no one can predict where and when it will strike.

A scaly biped, the tarrasque is fifty feet tall and seventy feet long, weighing hundreds of tons. It carries itself like a bird of prey, leaning forward and using its powerful lashing tail for balance. Its cavernous maw yawns wide enough to swallow all but the largest creatures, and so great is its hunger that it can devour the populations of whole towns.

Legendary Destruction. The destructive potential of the tarrasque is so vast that some cultures incorporate the monster into religious doctrine, weaving its sporadic appearance into stories of divine judgment and wrath.

Legends tell how the tarrasque slumbers in its secret lair beneath the earth, remaining in a dormant state for decades or centuries. When it awakens in answer to some inscrutable cosmic call, it rises from the depths to obliterate everything in its path.
",
  has challenge-rating "30",
  has hit-points 676,
  has armor-class 25,
  has alignment "Unaligned",
  has strength 30,
  has dexterity 11,
  has constitution 30,
  has intelligence 3,
  has wisdom 11,
  has charisma 11,
  has proficiency-bonus 9,
  has passive-perception 10,
  has speed-walk 40,
  has size "Gargantuan",
  has creature-type "Monstrosity",
  has damage-immunity "fire",
  has damage-immunity "poison",
  has damage-immunity "bludgeoning, piercing, and slashing from nonmagical attacks",
  has condition-immunity "charmed",
  has condition-immunity "frightened",
  has condition-immunity "paralyzed",
  has condition-immunity "poisoned",
  has sense "blindsight 120ft.",
  has save-intelligence 5,
  has save-wisdom 9,
  has save-charisma 9;

$lr isa trait, has name "Legendary Resistance (3/Day)", has description "If the tarrasque fails a saving throw, it can choose to succeed instead.";
has-ability ($m, $lr);

$mr isa trait, has name "Magic Resistance", has description "The tarrasque has advantage on saving throws against spells and other magical effects.";
has-ability ($m, $mr);

$rc isa trait, has name "Reflective Carapace", has description "Any time the tarrasque is targeted by a magic missile spell, a line spell, or a spell that requires a ranged attack roll, roll a d6. On a 1 to 5, the tarrasque is unaffected. On a 6, the tarrasque is unaffected, and the effect is reflected back at the caster as though it originated from the tarrasque, turning the caster into the target.";
has-ability ($m, $rc);

$sm isa trait, has name "Siege Monster", has description "The tarrasque deals double damage to objects and structures.";
has-ability ($m, $sm);

$ma isa action, has name "Multiattack", has description "The tarrasque can use its Frightful Presence. It then makes five attacks: one with its bite, two with its claws, one with its horns, and one with its tail. It can use its Swallow instead of its bite.";
has-ability ($m, $ma);

$b isa action, has name "Bite", has description "Melee Weapon Attack: +19 to hit, reach 10 ft., one target. Hit: 36 (4d12 + 10) piercing damage. If the target is a creature, it is grappled (escape DC 20). Until this grapple ends, the target is restrained, and the tarrasque can't bite another target.";
has-ability ($m, $b);

$c isa action, has name "Claw", has description "Melee Weapon Attack: +19 to hit, reach 15 ft., one target. Hit: 28 (4d8 + 10) slashing damage";
has-ability ($m, $c);

$fp isa action, has name "Frightful Presence", has description "Each creature of the tarrasque's choice within 120 feet of it and aware of it must succeed on a DC 17 Wisdom saving throw or become frightened for 1 minute. A creature can repeat the saving throw at the end of each of its turns, with disadvantage if the tarrasque is within line of sight, ending the effect on itself on a success. If a creature's saving throw is successful or the effect ends for it, the creature is immune to the tarrasque's Frightful Presence for the next 24 hours.";
has-ability ($m, $fp);

$swallow isa action, has name "Swallow", has description "The tarrasque makes one bite attack against a Large or smaller creature it is grappling. If the attack hits, the target takes the bite's damage, the target is swallowed, and the grapple ends. While swallowed, the creature is blinded and restrained, it has total cover against attacks and other effects outside the tarrasque, and it takes 56 (16d6) acid damage at the start of each of the tarrasque's turns.

If the tarrasque takes 60 damage or more on a single turn from a creature inside it, the tarrasque must succeed on a DC 20 Constitution saving throw at the end of that turn or regurgitate all swallowed creatures, which fall prone in a space within 10 feet of the tarrasque. If the tarrasque dies, a swallowed creature is no longer restrained by it and can escape from the corpse by using 30 feet of movement, exiting prone.";
has-ability ($m, $swallow);

$attack isa legendary-action, has name "Attack", has description "The tarrasque makes one claw attack or tail attack", has action-cost 1;
has-ability ($m, $attack);

$chomp isa legendary-action, has name "Chomp", has description "The tarrasque makes one bite attack or uses its Swallow.", has action-cost 2;
has-ability ($m, $chomp);

containment (container: $r, $m);

# Items

$broom isa magic-item, has id "broom", has name "Broom of Flying", has description "This wooden broom, which weighs 3 pounds, functions like a mundane broom until you stand astride it and speak its command word. It then hovers beneath you and can be ridden in the air. It has a flying speed of 50 feet. It can carry up to 400 pounds, but its flying speed becomes 30 feet while carrying over 200 pounds. The broom stops hovering when you land.

You can send the broom to travel alone to a destination within 1 mile of you if you speak the command word, name the location, and are familiar with that place. The broom comes back to you when you speak another command word, provided that the broom is still within 1 mile of you.", has rarity "Uncommon", has requires-attunement false;
containment (container: $r, contained: $broom);

$chest isa box-container, has name "Chest", has id "entryhallchest", has description "A small, non-descript wooden box";
containment (container: $r, contained: $chest);

$chestgold isa item, has name "Gold", has id "chestgold2", has description "A pile of 100 gold pieces";
containment(container: $chest, contained: $chestgold);

$leatherpouch isa box-container, has name "Leather pouch", has id "entryhallchest-leatherpouch", has description "A brown leather pouch, tied off with string";
containment (container: $chest, contained: $leatherpouch);

$electrum isa item, has name "Electrum", has id "leatherpouchelec", has description "5 electrum pieces";
containment (container: $leatherpouch, contained: $electrum);

$lpgold isa item, has name "Gold", has id "leatherpouchgolld", has description "3 gold pieces";
containment (container: $leatherpouch, contained: $lpgold);

$ring isa magic-item, has name "Ring of Feather Falling", has description "When you fall while wearing this ring, you descend 60 feet per round and take no damage from falling.", has id "leatherpouch-roff", has rarity "Rare", has requires-attunement true;
containment (container: $leatherpouch, contained: $ring);

# Treasure Chamber
$r2 isa room,
  has name "Treasure Chamber",
  has id "superawesomedungeon-treasurechamber",
  has description "A small chamber with glittering treasures piled on stone shelves";
dungeon-composition ($d, $r2);

# Add treasure to the chamber
$treasure isa magic-item,
  has name "Sword of Sharpness",
  has id "treasurechamber-sword",
  has description "A gleaming longsword with a razor-sharp edge that can sever limbs",
  has rarity "Very Rare",
  has requires-attunement true;
containment (container: $r2, contained: $treasure);

$goldpile isa item,
  has name "Gold Pile",
  has id "treasurechamber-gold",
  has description "A pile of 500 gold pieces";
containment (container: $r2, contained: $goldpile);

# Guard Post
$r3 isa room,
  has name "Guard Post",
  has id "superawesomedungeon-guardpost",
  has description "A small room with arrow slits in the walls and weapon racks";
dungeon-composition ($d, $r3);

# Add a guard NPC
$guard isa npc,
  has name "Guard Captain Thorne",
  has id "guardpost-captain",
  has description "A stern-looking human in chainmail, vigilantly watching the corridors",
  has hit-points 45,
  has armor-class 16,
  has level 5,
  has alignment "Lawful Neutral",
  has is-friendly false;
containment (container: $r3, contained: $guard);

# Hidden Study
$r4 isa room,
  has name "Hidden Study",
  has id "superawesomedungeon-hiddenstudy",
  has description "A dusty study filled with ancient tomes and scrolls";
dungeon-composition ($d, $r4);

# Add a spell scroll
$scroll isa magic-item,
  has name "Scroll of Fireball",
  has id "hiddenstudy-scroll",
  has description "A scroll containing the fireball spell",
  has rarity "Uncommon",
  has requires-attunement false;
containment (container: $r4, contained: $scroll);

# Add a trap in the study
$trap isa trap,
  has name "Poison Needle Trap",
  has id "hiddenstudy-trap",
  has description "A poison needle hidden in the desk drawer",
  has trap-type "Mechanical",
  has save-dc 15,
  has save-ability "DEX",
  has damage-dice "1d4",
  has damage-type "piercing",
  has damage-type "poison",
  has trigger-description "Triggered when the desk drawer is opened without disarming",
  has disarm-dc 18;
containment (container: $r4, contained: $trap);

# Room connections

# Connection 1: Regular door from Entry Hall to Guard Post (bidirectional)
room-connection (source-room: $entry_hall, target-room: $r3),
  has connection-type "Door",
  has is-secret false,
  has is-one-way false,
  has is-locked false,
  has description "A sturdy oak door with iron bands and a brass handle";

# Connection 2: Locked door from Guard Post to Treasure Chamber (bidirectional)
room-connection (source-room: $r3, target-room: $r2),
  has connection-type "Door",
  has is-secret false,
  has is-one-way false,
  has is-locked true,
  has description "A heavy iron door with an ornate lock. The guard captain has the key.";

# Connection 3: Secret one-way passage from Treasure Chamber to Hidden Study
room-connection (source-room: $r2, target-room: $r4),
  has connection-type "Passage",
  has is-secret true,
  has is-one-way true,
  has is-locked false,
  has description "A hidden passage behind a movable bookshelf, leading down narrow stone stairs";

# Connection 4: Long corridor from Entry Hall to Treasure Chamber (bidirectional)
room-connection (source-room: $entry_hall, target-room: $r2),
  has connection-type "Corridor",
  has is-secret false,
  has is-one-way false,
  has is-locked false,
  has description "A long, dimly-lit corridor with torch sconces every 20 feet. The eastern passage.";

# Connection 5: Secret locked passage from Hidden Study back to Entry Hall (one-way)
room-connection (source-room: $r4, target-room: $entry_hall),
  has connection-type "Passage",
  has is-secret true,
  has is-one-way true,
  has is-locked true,
  has description "A secret passage concealed behind a false wall panel, secured with a magical lock";
