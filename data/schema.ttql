define

# ============================================================================
# Attribute Types
# ============================================================================

attribute id, value string;
attribute name, value string;
attribute description, value string;
attribute level, value integer;
attribute hit-points, value integer;
attribute armor-class, value integer;
attribute is-friendly, value boolean;
attribute alignment, value string @values(
    "Lawful Good",
    "Neutral Good",
    "Chaotic Good",
    "Lawful Neutral",
    "True Neutral",
    "Chaotic Neutral",
    "Lawful Evil",
    "Neutral Evil",
    "Chaotic Evil",
    "Unaligned"
);
attribute requires-attunement, value boolean;
attribute rarity, value string @values(
    "Common",
    "Uncommon",
    "Rare",
    "Very Rare",
    "Legendary",
    "Artifact"
);

# Ability Scores
attribute strength, value integer @range(1, 30);
attribute dexterity, value integer @range(1, 30);
attribute constitution, value integer @range(1, 30);
attribute intelligence, value integer @range(1, 30);
attribute wisdom, value integer @range(1, 30);
attribute charisma, value integer @range(1, 30);

# Combat Stats
attribute challenge-rating, value string;
attribute experience-points, value integer;
attribute proficiency-bonus, value integer;
attribute passive-perception, value integer;

# Speed (in feet)
attribute speed-walk, value integer;
attribute speed-fly, value integer;
attribute speed-swim, value integer;
attribute speed-burrow, value integer;
attribute speed-climb, value integer;

# Creature Details
attribute size, value string @values("Tiny", "Small", "Medium", "Large", "Huge", "Gargantuan");
attribute creature-type, value string @values("Aberration", "Beast", "Celestial", "Construct", "Dragon", "Elemental", "Fey", "Fiend", "Giant", "Humanoid", "Monstrosity", "Ooze", "Plant", "Undead");

# Lists (comma-separated strings)
attribute damage-resistances, value string;
attribute damage-immunities, value string;
attribute condition-immunities, value string;
attribute damage-vulnerabilities, value string;
attribute languages, value string;
attribute senses, value string;

# Saving Throws
attribute save-strength, value integer;
attribute save-dexterity, value integer;
attribute save-constitution, value integer;
attribute save-intelligence, value integer;
attribute save-wisdom, value integer;
attribute save-charisma, value integer;

# Skills
attribute skill-acrobatics, value integer;
attribute skill-animal-handling, value integer;
attribute skill-arcana, value integer;
attribute skill-athletics, value integer;
attribute skill-deception, value integer;
attribute skill-history, value integer;
attribute skill-insight, value integer;
attribute skill-intimidation, value integer;
attribute skill-investigation, value integer;
attribute skill-medicine, value integer;
attribute skill-nature, value integer;
attribute skill-perception, value integer;
attribute skill-performance, value integer;
attribute skill-persuasion, value integer;
attribute skill-religion, value integer;
attribute skill-sleight-of-hand, value integer;
attribute skill-stealth, value integer;
attribute skill-survival, value integer;

# Action cost for legendary actions
attribute action-cost, value integer;

# ============================================================================
# Entity Types - Creatures
# ============================================================================

entity creature @abstract,
    owns name,
    owns description,
    owns level,
    owns hit-points,
    owns armor-class,
    owns alignment,
    plays containment:contained,
    plays has-ability:creature;

entity statblock-creature @abstract, sub creature,
    owns strength,
    owns dexterity,
    owns constitution,
    owns intelligence,
    owns wisdom,
    owns charisma,
    owns challenge-rating,
    owns experience-points,
    owns proficiency-bonus,
    owns passive-perception,
    owns speed-walk,
    owns speed-fly,
    owns speed-swim,
    owns speed-burrow,
    owns speed-climb,
    owns size,
    owns creature-type,
    owns damage-resistances,
    owns damage-immunities,
    owns condition-immunities,
    owns damage-vulnerabilities,
    owns languages,
    owns senses,
    owns save-strength,
    owns save-dexterity,
    owns save-constitution,
    owns save-intelligence,
    owns save-wisdom,
    owns save-charisma,
    owns skill-acrobatics,
    owns skill-animal-handling,
    owns skill-arcana,
    owns skill-athletics,
    owns skill-deception,
    owns skill-history,
    owns skill-insight,
    owns skill-intimidation,
    owns skill-investigation,
    owns skill-medicine,
    owns skill-nature,
    owns skill-perception,
    owns skill-performance,
    owns skill-persuasion,
    owns skill-religion,
    owns skill-sleight-of-hand,
    owns skill-stealth,
    owns skill-survival;

entity monster, sub statblock-creature;

entity npc, sub statblock-creature,
    owns is-friendly;

entity pc, sub creature;

# ============================================================================
# Entity Types - Containers
# ============================================================================

entity container @abstract,
    owns name,
    owns description,
    plays containment:container,
    plays containment:contained;

entity room, sub container,
    plays dungeon-composition:room-in-dungeon;

entity box-container, sub container;

# ============================================================================
# Entity Types - Dungeons and Items
# ============================================================================

entity dungeon,
    owns id @key,
    owns name,
    owns description,
    plays dungeon-composition:dungeon;

entity item,
    owns name,
    owns description,
    plays containment:contained;

entity magic-item, sub item,
    owns requires-attunement,
    owns rarity;

# ============================================================================
# Entity Types - Creature Abilities
# ============================================================================

entity creature-ability @abstract,
    owns name,
    owns description,
    plays has-ability:ability;

entity trait, sub creature-ability;
entity action, sub creature-ability;
entity bonus-action, sub creature-ability;
entity reaction, sub creature-ability;
entity legendary-action, sub creature-ability,
    owns action-cost;
entity lair-action, sub creature-ability;
entity mythic-action, sub creature-ability;

# ============================================================================
# Relation Types
# ============================================================================

relation containment,
    relates container,
    relates contained;

relation dungeon-composition,
    relates dungeon,
    relates room-in-dungeon;

relation has-ability,
    relates creature,
    relates ability;
